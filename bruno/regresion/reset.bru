meta {
  name: reset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reset
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.books: eq 3
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Preparación: deja el estado en los 3 libros iniciales (ids 1, 2 y 3).
}
