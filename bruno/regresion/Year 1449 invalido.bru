meta {
  name: Year 1449 invalido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Libro antiguo",
    "author": "Anonimo",
    "year": 1449
  }
}

assert {
  @description('entiende el request pero no es valido')
  res.status: eq 422
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Técnica ISTQB: Análisis de valores límite. 1449 queda justo debajo del límite inferior (1450).
}
