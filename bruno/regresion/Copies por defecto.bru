meta {
  name: Copies por defecto
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Refactoring",
    "author": "Martin Fowler",
    "year": 1999
  }
}

assert {
  res.status: eq 201
  res.body.copies: eq 1
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Técnica ISTQB: Partición de equivalencia. Clase válida sin el campo opcional copies; debe tomar el valor por defecto 1.
}
