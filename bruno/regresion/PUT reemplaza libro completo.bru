meta {
  name: PUT reemplaza libro completo
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/books/1
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Grokking Continuous Delivery 2nd Ed",
    "author": "Christie Wilson",
    "year": 2024
  }
}

tests {
  test("PUT reemplaza todo y copies vuelve a 1", function() {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Grokking Continuous Delivery 2nd Ed");
    expect(res.body.copies).to.equal(1);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Técnica ISTQB: Tabla de decisión. Regla: PUT reemplaza el libro completo. Si no se envía copies, vuelve al valor por defecto 1 (el libro 1 tenía 3).
}
