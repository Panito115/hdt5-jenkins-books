meta {
  name: Copies 1000 invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Muchas copias",
    "author": "Anonimo",
    "year": 2020,
    "copies": 1000
  }
}

assert {
  res.status: eq 422
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Técnica ISTQB: Análisis de valores límite. copies válido es 0 a 999; 1000 queda fuera del límite superior.
}
