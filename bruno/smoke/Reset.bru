meta {
  name: Reset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reset
  body: none
  auth: inherit
}

assert {
  @description('recibe y envia correctamente')
  res.status: eq 200
  @description('el número de libros')
  res.body.books: eq 3
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
