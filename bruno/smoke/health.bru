meta {
  name: health
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: inherit
}

assert {
  @description('servidor responde')
  res.status: eq 200
  @description('el api aporta que está sano')
  res.body.status: eq ok
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
