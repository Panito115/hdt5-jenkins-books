meta {
  name: leer el libro creado anteriormente
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/books/4
  body: none
  auth: inherit
}

assert {
  @description('el libro si existe')
  res.status: eq 200
  @description('es el mismo libro que se creo')
  res.body.title: eq Clean Code
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
